{
  "name": "graphopper-cli",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive and automation-safe command-line client for graphopper-backend",
  "type": "module",
  "bin": {
    "graphopper": "dist/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/make-executable.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build && npm run pack:check",
    "dev": "tsx src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "pack:check": "npm pack --dry-run --cache .npm-cache",
    "release:artifact": "npm run build && node scripts/release-artifact.mjs",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "^2.1.1",
    "commander": "^15.0.0",
    "open": "^11.0.4",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
