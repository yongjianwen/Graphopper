NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
DATABASE_URL=postgresql://graphopper:graphopper@127.0.0.1:5432/graphopper
OIDC_ISSUER=https://identity.example.com/
OIDC_AUDIENCE=graphopper-backend
OIDC_JWKS_URL=https://identity.example.com/.well-known/jwks.json
OIDC_REQUIRED_SCOPE=graphopper
JIT_PROVISIONING=true
CURSOR_SECRET=replace-with-a-long-random-secret
MAX_PAGE_SIZE=200
MAX_UPLOAD_BYTES=26214400
MAX_TEMPLATE_MIGRATION_NODES=10000
