{
  "name": "graphopper-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated backend API and authoritative graph data store for Graphopper",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test && npm run build",
    "db:migrate": "node-pg-migrate up --migrations-dir migrations --database-url-var DATABASE_URL",
    "db:migrate:down": "node-pg-migrate down --migrations-dir migrations --database-url-var DATABASE_URL",
    "dev": "tsx watch src/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "start": "node dist/main.js",
    "test": "vitest run --exclude 'test/integration/**'",
    "test:integration": "vitest run test/integration",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "fastify": "^5.12.1",
    "jose": "^6.2.9",
    "kysely": "^0.29.5",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.0",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@eslint/js": "^10.0.1",
    "@testcontainers/postgresql": "^12.1.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11",
    "yaml": "^2.9.0"
  }
}
